# Firebase Web App credentials (Project Settings → General → Your apps → Web app)
# Сите варијабли мораат да почнуваат со VITE_ за да бидат експонирани во клиентот.
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# RAG API entrypoint (must point to a secure backend proxy, never direct model keys in browser)
VITE_RAG_API_BASE_URL=http://localhost:8787/api

# Optional client feature flags
VITE_RAG_ENABLED=false
VITE_RAG_DEFAULT_NAMESPACE=makedotest
